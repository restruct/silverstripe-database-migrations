{
    "name": "restruct/silverstripe-database-migrations",
    "description": "Database migration utilities for SilverStripe: table renames, classname remapping, column renames, and table merges during dev/build",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\Migrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\SilverStripe\\Migrations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
