{
    "name": "restruct/silverstripe-database-migrations",
    "description": "Rename DataObject classes, tables and columns without losing data: dev/build remaps ClassName values, renames tables and columns, and merges retired tables into their replacements",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "database",
        "migration",
        "schema",
        "dev-build",
        "classname-remapping"
    ],
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5 || ^6"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3 || ^4"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\SilverStripe\\Migrations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\SilverStripe\\Migrations\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/restruct"
        }
    ]
}
